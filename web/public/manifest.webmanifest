{
  "id": "./",
  "name": "Registro de Riesgos Santa Marta",
  "short_name": "Riesgos SM",
  "description": "Reporta problemáticas, riesgos y daños de Santa Marta y sigue su atención.",
  "lang": "es-CO",
  "dir": "ltr",
  "start_url": "./#/home",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#03256c",
  "theme_color": "#0077b6",
  "categories": ["government", "utilities", "navigation"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Reportar problemática", "short_name": "Reportar", "url": "./#/report/new", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Mapa de Riesgos", "short_name": "Mapa", "url": "./#/map", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ],
  "screenshots": [
    { "src": "icons/screenshot-mobile.png", "sizes": "540x1170", "type": "image/png", "form_factor": "narrow", "label": "Inicio de Registro de Riesgos Santa Marta" },
    { "src": "icons/screenshot-wide.png", "sizes": "1280x800", "type": "image/png", "form_factor": "wide", "label": "Panel administrativo" }
  ]
